# GitHub repo the runner serves.
REPO_URL=https://github.com/colldem/Colld3mCRM

# Fine-grained personal access token, scoped to ONLY this repository, with
# permissions: "Administration: Read and write" (register runners) +
# "Actions: Read". Never a classic token. Rotate periodically.
ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxx

# Host docker group id:  getent group docker | cut -d: -f3   (usually 121 here)
DOCKER_GID=121

# Pin after the first pull:
#   docker compose pull
#   docker inspect --format '{{index .RepoDigests 0}}' $(docker compose config --images)
RUNNER_IMAGE=myoung34/github-runner:2.328.0@sha256:REPLACE_ME
