POSTGRES_PASSWORD=replace-with-long-random-value
DJANGO_SECRET_KEY=replace-with-long-random-value
CRM_SETUP_TOKEN=replace-with-long-random-one-time-token
DJANGO_ALLOWED_HOSTS=crm.example-tailnet.ts.net,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example-tailnet.ts.net
DJANGO_FORCE_HTTPS=true
DJANGO_SESSION_IDLE_MINUTES=480
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
CRM_BIND_IP=127.0.0.1
CRM_LAN_PORT=18081
TS_HOSTNAME=crm
TS_AUTHKEY=
TS_CERT_DOMAIN=crm.example-tailnet.ts.net

# Šifravimo raktas integracijų slaptažodžiams, suvestiems per Nustatymus (SMTP,
# IMAP, Entra secret). Sugeneruokite vieną kartą ir laikykite tik čia:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRM_SECRETS_KEY=

# CRM adresas nuorodoms laiškuose ir kalendoriaus faile (galima ir per Nustatymus).
CRM_BASE_URL=https://crm.example-tailnet.ts.net

# Foninio darbuotojo (crm-worker) ciklo intervalas sekundėmis.
WORKER_INTERVAL_SECONDS=300

# --- Neprivaloma: integracijų atsarginė konfigūracija ---
# Pagrindinis būdas — Nustatymai → Pranešimai / Gauti laiškai / Prisijungimas.
# Šie kintamieji naudojami tik jei atitinkamas laukas Nustatymuose paliktas tuščias.

# El. pašto pranešimai (G7).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=crm@example.lt

# Gaunami laiškai (G6).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Microsoft Entra ID prisijungimas (G5).
OIDC_ENABLED=false
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_CREATE_USERS=false
