# Copy to .env and fill in. Only the first section is required to start.
#
#   cp .env.example .env
#   docker compose up -d          ->  http://127.0.0.1:8080
#
# Full instructions, including HTTPS on your own domain: docs/DEPLOYMENT.md

# --- Required -----------------------------------------------------------
# Generate each of these once, with something like:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-with-long-random-value
DJANGO_SECRET_KEY=replace-with-long-random-value

# One-time token that unlocks /setup/ to create the first admin account.
# The setup page turns itself off once a user exists.
CRM_SETUP_TOKEN=replace-with-long-random-one-time-token

# Encryption key for the integration passwords entered in the Settings UI (SMTP,
# IMAP, Entra secret). Without it those fields cannot be saved. Generate once:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it here only. Losing it makes the stored integration passwords unreadable.
CRM_SECRETS_KEY=

# --- How the CRM is exposed ---------------------------------------------
# Leave COMPOSE_FILE unset for a plain deployment on 127.0.0.1:8080 (put your own
# reverse proxy in front of it). Otherwise pick one overlay:
#
#   COMPOSE_FILE=compose.yaml:compose.caddy.yaml       HTTPS on your own domain
#   COMPOSE_FILE=compose.yaml:compose.tailscale.yaml   private Tailscale network
#
# With it set, plain `docker compose up -d` uses the overlay — no -f flags.
#COMPOSE_FILE=compose.yaml:compose.caddy.yaml

# Host and port the base file publishes. 127.0.0.1 keeps it off the network:
# widen it only if something in front terminates TLS.
CRM_BIND_IP=127.0.0.1
CRM_PORT=8080

# Your hostname. Must match how users reach the CRM, or Django rejects requests.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Turn on once HTTPS works, so cookies are marked secure and HTTP is redirected.
DJANGO_FORCE_HTTPS=false
# Absolute base for links inside emails and calendar files, where there is no
# incoming request to derive it from.
CRM_BASE_URL=http://127.0.0.1:8080

# --- With compose.caddy.yaml --------------------------------------------
# A DNS record for CRM_DOMAIN must point at this host, and ports 80 and 443 must
# be reachable: Let's Encrypt validates over port 80.
#CRM_DOMAIN=crm.example.com
#CRM_ACME_EMAIL=admin@example.com

# --- With compose.tailscale.yaml ----------------------------------------
# Auth key from the Tailscale admin console (Settings -> Keys).
#TS_AUTHKEY=
#TS_HOSTNAME=crm
#TS_CERT_DOMAIN=crm.your-tailnet.ts.net
#CRM_LAN_PORT=18081

# --- Behaviour -----------------------------------------------------------
DJANGO_SESSION_IDLE_MINUTES=480
WORKER_INTERVAL_SECONDS=300
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
# Encrypt backups for these age public keys (space separated); the private key
# stays off this host. See docs/DEPLOYMENT.md "Backups and restore".
BACKUP_AGE_RECIPIENTS=
BACKUP_REQUIRE_ENCRYPTION=false
# Optional off-host copy: an rclone destination, with runtime/backup-config/rclone.conf.
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30

# Deployment tier. Anything other than "production" marks this as an isolated
# copy: SMTP, IMAP, Entra and webhooks are forced off whatever the database says,
# and a red banner names the tier. Set it on any instance restored from a copy of
# production data, so it cannot act on real contacts.
# Sample rows in the record card's registry blocks; ignored in production.
#CRM_DEMO_BLOCKS=1
# Apps installed beside the CRM (comma separated); `regitra` = Regitros integracija.
#CRM_EXTRA_APPS=regitra
CRM_ENVIRONMENT=production
# Staging only, and only alongside TS_SERVE_CONFIG=/config/serve-staging-funnel.json:
# confirms that this copy is meant to be on the public internet. Read the checklist
# in docs/DEPLOYMENT.md (Publishing a staging instance) first — the sign-in page becomes reachable by anyone.
#CRM_STAGING_PUBLIC=1

# --- Optional: integration fallbacks ------------------------------------
# The Settings UI (Notifications / Incoming mail / Sign-in) is the primary place
# to configure these. The values below are used only where that field is blank.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Microsoft Entra ID single sign-on.
OIDC_ENABLED=false
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_CREATE_USERS=false

# With "Tik organizacijos prisijungimas" (SSO only) switched on in Settings, only
# these usernames may still sign in with a local password — the break-glass
# accounts for when the directory is unreachable. Comma-separated. Empty: active
# superusers only.
CRM_BREAK_GLASS_USERS=

# Logs on stdout. "json" (default): one JSON object per line with request_id, for
# a SIEM; "text" for reading by eye. Level: DEBUG, INFO, WARNING, ERROR.
CRM_LOG_FORMAT=json
CRM_LOG_LEVEL=INFO

# Reverse proxy networks (CIDR, comma-separated) whose X-Forwarded-For header is
# trusted for the client address (audit trail, sign-in lockout). The Caddy and
# Tailscale overlays set this; set it yourself behind your own proxy.
CRM_TRUSTED_PROXIES=

# Django's /admin/ bypasses the CRM audit trail; off unless needed, then superusers only.
CRM_DJANGO_ADMIN=false

# Bearer token that unlocks /metrics for Prometheus; empty keeps it off.
CRM_METRICS_TOKEN=

# Malware scanning of uploads. compose.clamav.yaml sets the host for you; set it
# yourself only for an external clamd. REQUIRED=true refuses uploads while the
# scanner is down, false accepts them unscanned (with a logged warning).
CRM_CLAMAV_HOST=
CRM_CLAMAV_PORT=3310
CRM_CLAMAV_TIMEOUT=30
CRM_CLAMAV_REQUIRED=true

# Send the Content-Security-Policy as report-only while checking a new setup.
CRM_CSP_REPORT_ONLY=false

# JSON API requests allowed per token per minute; beyond it the API answers 429
# with Retry-After. 0 disables the limit.
CRM_API_RATE_LIMIT=120

# How long a password-reset link e-mailed to a user stays valid, in seconds.
CRM_PASSWORD_RESET_TIMEOUT=3600

# --- Uploaded files ---------------------------------------------------------
# "filesystem" (default) keeps them in runtime/media next to the project — right
# for a single Docker host. "s3" stores them in S3-compatible object storage,
# which is what you need when more than one web replica serves the app
# (Kubernetes); see docs/KUBERNETES.md.
#CRM_MEDIA_BACKEND=s3
#CRM_S3_BUCKET=crm-media
#CRM_S3_ENDPOINT=https://minio.example.com
#CRM_S3_REGION=
#CRM_S3_ACCESS_KEY=
#CRM_S3_SECRET_KEY=
# "path" for MinIO and most self-hosted gateways, "virtual" for AWS S3.
#CRM_S3_ADDRESSING=path

# --- Container start-up ------------------------------------------------------
# Both default to 1, which is what a Compose install wants. Kubernetes sets them
# to 0: migrations run once per release in a Job, and the static files are
# already baked into the image.
#CRM_RUN_MIGRATIONS=0
#CRM_COLLECTSTATIC=0

# Gunicorn, as started by scripts/entrypoint.sh. The defaults suit a NAS or a
# small VPS; each worker is a full copy of the app, so raise them only if the
# host has the cores and the memory.
#CRM_GUNICORN_PORT=8080
#CRM_GUNICORN_WORKERS=2
#CRM_GUNICORN_THREADS=2
#CRM_GUNICORN_TIMEOUT=60
# Idle keep-alive seconds: longer than the proxy's upstream keep-alive, or the
# proxy may reuse a connection the app is closing (a dropped request).
#CRM_GUNICORN_KEEPALIVE=75

