POSTGRES_PASSWORD=replace-with-long-random-value
DJANGO_SECRET_KEY=replace-with-long-random-value
CRM_SETUP_TOKEN=replace-with-long-random-one-time-token
DJANGO_ALLOWED_HOSTS=crm.example-tailnet.ts.net,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example-tailnet.ts.net
DJANGO_FORCE_HTTPS=true
DJANGO_SESSION_IDLE_MINUTES=480
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
CRM_BIND_IP=127.0.0.1
CRM_LAN_PORT=18081
TS_HOSTNAME=crm
TS_AUTHKEY=
TS_CERT_DOMAIN=crm.example-tailnet.ts.net

# El. pašto pranešimai (G7). Palikite EMAIL_HOST tuščią, kad siuntimas būtų išjungtas.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=crm@example.lt
CRM_BASE_URL=https://crm.example-tailnet.ts.net
